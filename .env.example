# Public catalog currently requires no credentials.
# Do not commit actual credentials. Provider authentication is not implemented.

# Future deployment only; do not provision yet.
# Browser-safe publishable values can be filled after a separate UNITY project exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Restricted server-only settings. Do NOT set these in public frontend env.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
UNITY_WORKER_SIGNING_SECRET=

# Merely requesting execution never activates the unimplemented runtime.
UNITY_ENABLE_EXTERNAL_EXECUTION=false

# Expected origin for cookie-authenticated writes; required when enabling private APIs.
UNITY_APP_ORIGIN=
