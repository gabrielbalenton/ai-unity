# UNITY Vercel preview can run without any secrets.
# Never commit real credentials. Values below are names/placeholders only.

# SAFE DEFAULTS — keep disabled through the first visual preview.
UNITY_ENABLE_EXTERNAL_EXECUTION=false
UNITY_ENABLE_GITHUB_WEBHOOK_INGESTION=false

# OPTIONAL CLOUD/AUTH — add only after provisioning a separate UNITY backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
UNITY_APP_ORIGIN=

# SERVER ONLY — never NEXT_PUBLIC, browser storage, source code or AI prompts.
UNITY_SUPABASE_BACKEND_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
UNITY_WORKER_SIGNING_SECRET=
# Random 32+ character value used only to encrypt short-lived Connect-flow tickets.
UNITY_CONNECTION_SESSION_SECRET=

# INFISICAL MACHINE IDENTITY BOOTSTRAP — server only.
# These two values let UNITY obtain short-lived Infisical access tokens.
# Do not add provider API keys here; those belong inside the Infisical vault.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_SECRET_PATH=/unity
