{
  "name": "ai-unity",
  "version": "0.31.0-rc.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "readiness": "node scripts/readiness.mjs",
    "test:e2e": "playwright test",
    "qa:commit": "npm test && npm run typecheck && npm run check:repo",
    "qa:push": "npm run verify:release",
    "guard:install": "npx --yes lefthook@2.1.17 install",
    "guard:validate": "npx --yes lefthook@2.1.17 validate",
    "verify:release": "npm test && npm run typecheck && npm run check:repo && npm run readiness && npm run build"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76",
    "lucide-react": "0.468.0",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.57.0"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.9.3",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": "22.x"
  }
}
